# Setup: copy this file to .env, put your fal.ai key in FAL_KEY (fal.ai/dashboard/keys),
# then run `npm install` and `npm run dev` and open http://localhost:4317.
# Keys stay server-side. GEMINI_API_KEY is optional: without it every call goes through fal.ai.
# On macOS a key left empty here is also looked up in the login keychain (services below).
GEMINI_API_KEY=
FAL_KEY=

# auto: Gemini API first, fal.ai when every Gemini key is out of quota or credit.
# gemini | fal: force one route.
IMAGE_PROVIDER=auto

# Nano Banana 2 on each route.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
FAL_IMAGE_MODEL=fal-ai/nano-banana-2/edit

# The reference is the most-played Roblox game matching each name. This image is used only when
# Roblox search returns nothing or fails (path relative to the app folder).
REFERENCE_IMAGE=reference/day-67-prison-dig.png
REFERENCE_NAME=DAY #67 prison dig

# Keychain services tried in order when the env var above is empty.
GEMINI_KEYCHAIN_SERVICES=gemini-api-key,nano-banana-gemini-key
FAL_KEYCHAIN_SERVICES=cosmos-fal,fal-key

PORT=4317
