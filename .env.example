# Setup: copy this file to .env, put a fal.ai key in FAL_KEY (fal.ai/dashboard/keys) and/or a
# Gemini key in GEMINI_API_KEY, then run `npm install` and `npm run dev` and open http://localhost:4327.
# Keys stay server-side. On macOS a key left empty here is also looked up in the login keychain
# (services below).
GEMINI_API_KEY=
FAL_KEY=

# auto: Gemini API first, fal.ai when Gemini fails (out of quota or credit, or no image back).
# gemini | fal: force one route.
IMAGE_PROVIDER=auto

# Nano Banana 2 on each route.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
FAL_IMAGE_MODEL=fal-ai/nano-banana-2/edit

# Text model that writes genre search queries and picks the nearest popular Roblox game:
# Gemini first, then this model on fal.ai (openrouter/router).
GEMINI_TEXT_MODEL=gemini-3.5-flash
FAL_TEXT_MODEL=anthropic/claude-haiku-5.5

# Vision models that judge the three thumbnails, tried in order, then the fal.ai one
# (openrouter/router/vision, reasoning on).
GEMINI_JUDGE_MODELS=gemini-3.1-pro-preview,gemini-3.5-flash
FAL_JUDGE_MODEL=anthropic/claude-sonnet-5.5

# "My reference image" for thumbnail 1 (path relative to the app folder). The page can swap in
# an uploaded image per run.
STYLE_REFERENCE=reference/day-67-prison-dig.png
STYLE_REFERENCE_NAME=DAY #67 prison dig

# Keychain services tried in order when the env var above is empty.
GEMINI_KEYCHAIN_SERVICES=gemini-api-key,nano-banana-gemini-key
FAL_KEYCHAIN_SERVICES=cosmos-fal,fal-key

PORT=4327
